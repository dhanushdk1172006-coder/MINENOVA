def add_event(message):

    timestamp = datetime.now().strftime(
        "%H:%M:%S"
    )

    event_log.insert(
        0,
        f"{timestamp}  {message}"
    )

    # Keep latest 7 events
    if len(event_log) > 7:

        event_log.pop()


