    # DISPLAY
    # ========================================================

    cv2.imshow(
        "MineNova Rescue Dashboard",
        dashboard
    )


    # ========================================================
    # KEYBOARD
    # ========================================================

    key = cv2.waitKey(1) & 0xFF


    # --------------------------------------------------------
    # Q / ESC = QUIT
    # --------------------------------------------------------

    if key == ord("q") or key == 27:

        break


    # --------------------------------------------------------
    # S = SAVE EVIDENCE
    # --------------------------------------------------------

    elif key == ord("s"):

        save_evidence(
            dashboard
        )


    # --------------------------------------------------------
    # R = RESET
    # --------------------------------------------------------

    elif key == ord("r"):

        detection_streak = 0
        lost_streak = 0

        confirmed_target = False

        last_detections = []

        add_event(
            "Target tracking reset"
        )


    # --------------------------------------------------------
    # T = THERMAL
    # --------------------------------------------------------

    elif key == ord("t"):

        thermal_enabled = (
            not thermal_enabled
        )

        add_event(
            "Thermal view "
            + (
                "enabled"
                if thermal_enabled
                else "disabled"
            )
        )


    # --------------------------------------------------------
    # A = AUTO MODE
    # --------------------------------------------------------

    elif key == ord("a"):

        rover_mode = "AUTO"

        rover_command = "STANDBY"

        add_event(
            "Rover mode AUTO"
        )


    # --------------------------------------------------------
    # M = MANUAL MODE
    # --------------------------------------------------------

    elif key == ord("m"):

        rover_mode = "MANUAL"

        rover_command = "STANDBY"

        add_event(
            "Rover mode MANUAL"
        )


    # --------------------------------------------------------
    # ARROW KEYS
    # --------------------------------------------------------

    elif key == 82:       # UP

        if rover_mode == "MANUAL":

            rover_command = "FORWARD"

            add_event(
                "Manual: FORWARD"
            )


    elif key == 84:       # DOWN

        if rover_mode == "MANUAL":

            rover_command = "BACKWARD"

            add_event(
                "Manual: BACKWARD"
            )


    elif key == 81:       # LEFT

        if rover_mode == "MANUAL":

            rover_command = "LEFT"

            add_event(
                "Manual: LEFT"
            )


    elif key == 83:       # RIGHT

        if rover_mode == "MANUAL":

            rover_command = "RIGHT"

            add_event(
                "Manual: RIGHT"
            )


