def get_direction(x, w, width):

    center_x = x + w // 2

    if center_x < width * 0.35:

        return "LEFT"

    elif center_x > width * 0.65:

        return "RIGHT"

    return "CENTER"


def get_target_info(detection):

    if detection is None:

        return None

    x, y, w, h, confidence = detection

    return {
        "x": x + w // 2,
        "y": y + h // 2,
        "width": w,
        "height": h,
        "confidence": confidence
    }


def draw_corner_box(
    image,
    x,
    y,
    w,
    h,
    color,
    thickness=2
):

    length = 22

    # Top left
    cv2.line(
        image,
        (x, y),
        (x + length, y),
        color,
        thickness
    )

    cv2.line(
        image,
        (x, y),
        (x, y + length),
        color,
        thickness
    )

    # Top right
    cv2.line(
        image,
        (x + w, y),
        (x + w - length, y),
        color,
        thickness
    )

    cv2.line(
        image,
        (x + w, y),
        (x + w, y + length),
        color,
        thickness
    )

    # Bottom left
    cv2.line(
        image,
        (x, y + h),
        (x + length, y + h),
        color,
        thickness
    )

    cv2.line(
        image,
        (x, y + h),
        (x, y + h - length),
        color,
        thickness
    )

    # Bottom right
    cv2.line(
        image,
        (x + w, y + h),
        (x + w - length, y + h),
        color,
        thickness
    )

    cv2.line(
        image,
        (x + w, y + h),
        (x + w, y + h - length),
        color,
        thickness
    )


def create_thermal(frame):

    gray = cv2.cvtColor(
        frame,
        cv2.COLOR_BGR2GRAY
    )

    gray = cv2.equalizeHist(gray)

    gray = cv2.GaussianBlur(
        gray,
        (5, 5),
        0
    )

    thermal = cv2.applyColorMap(
        gray,
        cv2.COLORMAP_JET
    )

    return thermal


def beep_alert():

    try:

        import winsound

        winsound.Beep(
            1200,
            150
        )

        winsound.Beep(
            1500,
            150
        )

    except Exception:

        pass


def save_evidence(dashboard):

    global screenshots_saved

    try:

        filename = (
            "MineNova_Evidence_"
            + datetime.now().strftime(
                "%Y%m%d_%H%M%S"
            )
            + ".jpg"
        )

        cv2.imwrite(
            filename,
            dashboard
        )

        screenshots_saved += 1

        add_event(
            "Evidence captured"
        )

        print(
            "[OK] Evidence saved:",
            filename
        )

    except Exception as e:

        print(
            "[ERROR] Screenshot failed:",
            e
        )


def draw_panel(
    image,
    x1,
    y1,
    x2,
    y2,
    title
):

    cv2.rectangle(
        image,
        (x1, y1),
        (x2, y2),
        DARK_GRAY,
        -1
    )

    cv2.rectangle(
        image,
        (x1, y1),
        (x2, y2),
        (80, 80, 80),
        1
    )

    cv2.putText(
        image,
        title,
        (x1 + 10, y1 + 22),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.50,
        CYAN,
        1
    )


def draw_text(
    image,
    text,
    x,
    y,
    color=WHITE,
    size=0.45,
    thickness=1
):

    cv2.putText(
        image,
        text,
        (x, y),
        cv2.FONT_HERSHEY_SIMPLEX,
        size,
        color,
        thickness,
        cv2.LINE_AA
    )


def format_mission_time():

    seconds = int(
        time.time() - mission_start
    )

    minutes = seconds // 60
    seconds = seconds % 60

    return f"{minutes:02d}:{seconds:02d}"


# ============================================================
# MAIN LOOP
# ============================================================

while True:

    frame_number += 1


    # ========================================================
    # CAMERA
    # ========================================================

    ret, frame = cap.read()

    if not ret:

        camera_status = "ERROR"

        print(
            "[ERROR] Camera frame unavailable"
        )

        cap.release()

        time.sleep(1)

        cap = cv2.VideoCapture(
            CAMERA_INDEX
        )

        if cap.isOpened():

            cap.set(
                cv2.CAP_PROP_FRAME_WIDTH,
                FRAME_WIDTH
            )

            cap.set(
                cv2.CAP_PROP_FRAME_HEIGHT,
                FRAME_HEIGHT
            )

            camera_status = "ONLINE"

            add_event(
                "Camera reconnected"
            )

            continue

        else:

            add_event(
                "Camera reconnect failed"
            )

            break


    camera_status = "ONLINE"


    frame = cv2.resize(
        frame,
        (FRAME_WIDTH, FRAME_HEIGHT)
    )


    # ========================================================
    # THERMAL
    # ========================================================

    thermal = create_thermal(frame)


    # ========================================================
    # DETECTION
    # ========================================================

    current_detections = []


    if (
        frame_number % DETECTION_INTERVAL == 0
        or not last_detections
    ):

        # ----------------------------------------------------
        # HOG
        # ----------------------------------------------------

        if hog_available:

            try:

                boxes, weights = hog.detectMultiScale(

                    frame,

                    winStride=(8, 8),

                    padding=(8, 8),

                    scale=1.05
                )


                for i, box in enumerate(boxes):

                    try:

                        confidence = float(
                            weights[i]
                        )

                    except Exception:

                        confidence = 0.50


                    if confidence < CONFIDENCE_THRESHOLD:

                        continue


                    x, y, w, h = box

                    if w < 30 or h < 60:

                        continue

                    if w > 600 or h > 475:

                        continue


                    current_detections.append(
                        (
                            int(x),
                            int(y),
                            int(w),
                            int(h),
                            confidence
                        )
                    )


            except Exception as e:

                print(
                    "[WARNING] HOG error:",
                    e
                )


        # ----------------------------------------------------
        # MOTION FALLBACK
        # ----------------------------------------------------

        if (
            not current_detections
            and USE_MOTION_FALLBACK
        ):

            mask = background.apply(
                frame
            )


            _, mask = cv2.threshold(
                mask,
                200,
                255,
                cv2.THRESH_BINARY
            )


            kernel = np.ones(
                (5, 5),
                np.uint8
            )


            mask = cv2.morphologyEx(
                mask,
                cv2.MORPH_OPEN,
                kernel
            )


            mask = cv2.morphologyEx(
                mask,
                cv2.MORPH_CLOSE,
                kernel
            )


            contours, _ = cv2.findContours(

                mask,

                cv2.RETR_EXTERNAL,

                cv2.CHAIN_APPROX_SIMPLE
            )


            candidates = []


            for contour in contours:

                area = cv2.contourArea(
                    contour
                )

                if area < MIN_OBJECT_AREA:

                    continue


                x, y, w, h = cv2.boundingRect(
                    contour
                )


                if w < MIN_OBJECT_WIDTH:

                    continue

                if h < MIN_OBJECT_HEIGHT:

                    continue


                ratio = h / max(
                    w,
                    1
                )


                if ratio < 1.0:

                    continue


                if w > 550 or h > 470:

                    continue


                candidates.append(
                    (
                        area,
                        x,
                        y,
                        w,
                        h
                    )
                )


            if candidates:

                candidates.sort(
                    reverse=True
                )

                _, x, y, w, h = candidates[0]

                current_detections.append(
                    (
                        x,
                        y,
                        w,
                        h,
                        0.60
                    )
                )


        last_detections = current_detections

    else:

        current_detections = last_detections


    # ========================================================
    # DETECTION STABILIZATION
    # ========================================================

    if current_detections:

        detection_streak += 1
        lost_streak = 0

    else:

        lost_streak += 1
        detection_streak = 0


    if detection_streak >= DETECTION_CONFIRM_FRAMES:

        confirmed_target = True


    if lost_streak >= DETECTION_LOST_FRAMES:

        confirmed_target = False


    # ========================================================
    # TARGET STATISTICS
    # ========================================================

    if current_detections:

        if not previous_confirmed_state:

            targets_found += 1


    if (
        confirmed_target
        and not previous_confirmed_state
    ):

        confirmed_targets += 1

        add_event(
            "Survivor target confirmed"
        )


    previous_confirmed_state = (
        confirmed_target
    )


    # ========================================================
    # BEST TARGET
    # ========================================================

    best_detection = None

    if current_detections:

        best_detection = max(
            current_detections,
            key=lambda d: d[2] * d[3]
        )


    target = get_target_info(
        best_detection
    )


    # ========================================================
    # TARGET DIRECTION
    # ========================================================

    direction = "NONE"

    if target:

        direction = get_direction(

            target["x"] - target["width"] // 2,

            target["width"],

            FRAME_WIDTH
        )


        # Simulated navigation coordinates
        map_target_x = int(
